{
  "name": "svatype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "node scripts/tauri.mjs build",
    "build:frontend": "vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "node --test scripts/*.test.mjs",
    "test:offline": "npm run build:frontend && node scripts/check-offline.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0"
  }
}

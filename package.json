{
  "name": "svatype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/tauri.mjs dev",
    "build": "node scripts/package.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:frontend": "npm run build:wasm && vite build",
    "build:frontend:dev": "npm run build:wasm && vite build --mode development",
    "check": "npm run build:wasm && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit && eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "npm run build:wasm && node --test scripts/*.test.mjs && vitest run",
    "test:offline": "npm run build:frontend && node scripts/check-offline.mjs",
    "perf": "node scripts/perf.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.6",
    "binaryen": "^132.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "^3.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}

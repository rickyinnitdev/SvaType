{
  "productName": "SvaType",
  "version": "0.1.0",
  "identifier": "org.svatype.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm run build:frontend:dev",
      "wait": true
    },
    "beforeBuildCommand": "npm run build:frontend",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "SvaType",
        "width": 1120,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "visible": false,
        "backgroundColor": "#f7f8fa",
        "additionalBrowserArgs": "--disable-features=msSmartScreenProtection,msWebOOUI,msPdfOOUI,ElasticOverscroll --disable-background-networking --disable-component-update --no-first-run --disable-crash-reporter --disable-breakpad --disable-domain-reliability --disable-sync"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "resources": {
      "../content/": "content/"
    },
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "webviewInstallMode": {
        "type": "skip"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["English"],
        "customLanguageFiles": {
          "English": "installer/English.nsh"
        }
      },
      "allowDowngrades": false,
      "minimumWebview2Version": "105.0.0.0"
    }
  }
}
